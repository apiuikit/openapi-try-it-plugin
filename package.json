{
  "name": "@apiuikit/openapi-try-it-plugin",
  "version": "0.2.0",
  "description": "A \"Try it out\" request-sending plugin for apiuikit, filling the openapi.operation.tab slot.",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/apiuikit/openapi-try-it-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apiuikit/openapi-try-it-plugin.git"
  },
  "homepage": "https://github.com/apiuikit/openapi-try-it-plugin#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/openapi-try-it-plugin.cjs.js",
  "module": "./dist/openapi-try-it-plugin.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/openapi-try-it-plugin.es.js",
      "require": "./dist/openapi-try-it-plugin.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "apiuikit": "^1.7.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "apiuikit": "^1.7.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@microlink/react-json-view": "^1.31.28"
  }
}
